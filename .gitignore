.workbuddy/
.vscode/
.DS_Store
Thumbs.db

# 根目录遗留的重复/失效 vite 配置（真实配置在 frontend/vite.config.js）
/vite.config.js

# ===== 环境变量 / 密钥 =====
.env
.env.*
