# 多阶段构建 - 后端
FROM python:3.11-slim as backend-builder

WORKDIR /app

# 安装编译依赖（ultralytics / opencv 等可选包在启用真实推理时可能需要）
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    cmake \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件（优先使用锁定文件以保证可复现构建）
COPY edge/requirements.lock.txt ./requirements.lock.txt
COPY edge/requirements.txt ./requirements.txt

# 安装 Python 依赖：默认从锁定文件安装；若锁定文件缺失则回退到 requirements.txt
RUN pip install --no-cache-dir -r requirements.lock.txt || pip install --no-cache-dir -r requirements.txt

# 可选：启用真实 YOLO 推理（拉取 ultralytics + opencv，镜像体积显著增大）
# 使用方式：docker-compose build --build-arg REAL_INFERENCE=1 backend
ARG REAL_INFERENCE=0
RUN if [ "$REAL_INFERENCE" = "1" ]; then pip install --no-cache-dir ultralytics opencv-python-headless; fi

# 复制源代码
COPY edge/src ./src
COPY edge/main.py .
COPY edge/config ./config

# 多阶段构建 - 运行时
FROM python:3.11-slim

WORKDIR /app

# 创建非 root 用户
RUN groupadd -r aibc && useradd -r -g aibc aibc

# 从 builder 阶段复制已安装的依赖
COPY --from=backend-builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=backend-builder /usr/local/bin/uvicorn /usr/local/bin/uvicorn

# 复制应用代码
COPY --from=backend-builder /app ./

# 复制内置模型权重（与 docker-compose 挂载的 ./edge/model 对齐；运行时挂载优先生效）
COPY edge/model ./model

# 创建必要的目录并设置归属
RUN mkdir -p /app/data /app/logs /app/model && \
    chown -R aibc:aibc /app

# 切换到非 root 用户
USER aibc

# 暴露端口
EXPOSE 8000

# 健康检查（使用标准库 urllib，避免额外依赖 requests）
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/v1/health', timeout=5)" || exit 1

# 启动命令
CMD ["python", "main.py"]
